# Database (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# JWT
JWT_SECRET="change-me-min-32-chars-random-string"
JWT_REFRESH_SECRET="change-me-different-min-32-chars"

# App
PORT=3001
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (email)
RESEND_API_KEY=""
EMAIL_FROM="noreply@tusaas.es"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Redis (Railway)
REDIS_URL="redis://localhost:6379"

# VeriFactu certificate encryption (required for VeriFactu digital certificates)
CERT_ENCRYPTION_KEY=""

# Comma-separated emails auto-promoted to SUPER_ADMIN on login
PLATFORM_ADMIN_EMAILS=""

# AEAT VeriFactu environment: "test" or "production"
AEAT_ENV="test"

# AI-powered expense/receipt scanner (optional)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
CLAUDE_API_KEY=""
NVIDIA_API_KEY=""

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sentry
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"
